DEPTH = 24;           -- 24个存储单元
WIDTH = 7;            -- 每个单元7位宽
ADDRESS_RADIX = DEC;  -- 地址采用十进制表示
DATA_RADIX = BIN;     -- 数据采用二进制表示

CONTENT
BEGIN
    -- 地址 : 数据（bit6-5:颜色, bit4-3:形状, bit2-1:角度, bit0:需放置标志）
    -- 颜色编码：00=红 01=蓝 10=黄 11=黑
    -- 形状编码：00=三角 01=六边 10=圆形 11=方形
    
   0 : 0000000;  -- 
   1 : 0000000;  -- 
   2 : 0011001;  -- 红方
   3 : 0000000;  -- 
   
   4 : 0000000;  -- 
   5 : 0000000;  -- 
   6 : 1110001;  -- 黑圆
   7 : 0000000;  -- 
   
   8 :  0000000;  --
   9 :  1000001;  --黄三角
   10 : 1011001; -- 黄方
   11 : 1100001; -- 黑三角
   
   12 :0000000; -- 
   13 :0000001; -- 红三角
   14 :0010001; -- 红圆
   15 :0011001; -- 红方
   
   16 : 0000000; -- 
   17 : 0000000; -- 
   18 : 1111001; -- 黑方
   19 : 0000000; -- 
   
   20 : 0000000; -- 
   21 : 0000000; -- 
   22 : 1010001; -- 黄圆
   23 : 0000000; -- 
END;//00 00 00 00